# Copy this file to .env for local testing (never commit .env to git)
# 1. Google Drive folder ID for images: https://drive.google.com/drive/folders/<GDRIVE_FOLDER_ID>
GDRIVE_FOLDER_ID=
# 2. Google Drive folder ID for place Markdown (.md) files:
GDRIVE_PLACES_FOLDER_ID=
# 3. Free read-only API key from Google Cloud Console (Google Drive API enabled)
GDRIVE_API_KEY=
