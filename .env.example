# Copy this file to .env for local testing (never commit .env or credentials/ to git)
# 1. Google Drive folder ID for images: https://drive.google.com/drive/folders/<GDRIVE_FOLDER_ID>
GDRIVE_FOLDER_ID=
# 2. Google Drive folder ID for place Markdown (.md) files:
GDRIVE_PLACES_FOLDER_ID=

# 3. Recommended Auth: Google Cloud Service Account (prevents 403 automated-query blocks)
#    Local dev: place your downloaded JSON key at credentials/service-account.json
GDRIVE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
#    Render / Cloud: paste the JSON (or base64-encoded JSON) directly into this env var instead
# GDRIVE_SERVICE_ACCOUNT_JSON=

# Optional fallback (if not using Service Account):
# GDRIVE_API_KEY=
